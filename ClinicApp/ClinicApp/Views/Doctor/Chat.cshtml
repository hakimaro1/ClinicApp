@model IEnumerable<ClinicApp.Models.Message>
@using ClinicApp.Models
@{
    var appointment = ViewBag.Appointment as Appointment;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<h2>Чат с пациентом</h2>
<h4>Прием: @appointment?.TimeSlot?.Start.ToString("dd.MM.yyyy HH:mm")</h4>

<div class="card mb-3" style="height: 400px; overflow-y: scroll; background-color: #f8f9fa;">
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-muted text-center">Сообщений пока нет.</p>
        }
        @foreach (var msg in Model)
        {
            var isMe = msg.SenderId == currentUserId;
            <div class="d-flex @(isMe ? "justify-content-end" : "justify-content-start") mb-2">
                <div class="p-2 rounded @(isMe ? "bg-primary text-white" : "bg-white border")" style="max-width: 70%;">
                    <p class="mb-1">@msg.Text</p>
                    <small class="@(isMe ? "text-light" : "text-muted")" style="font-size: 0.7rem;">
                        @msg.SentAt.ToString("dd.MM.yyyy HH:mm")
                    </small>
                </div>
            </div>
        }
    </div>
</div>

<form asp-action="SendMessage" method="post" class="d-flex gap-2">
    <input type="hidden" name="appointmentId" value="@appointment?.Id" />
    <input type="text" name="text" class="form-control" placeholder="Напишите сообщение..." required />
    <button type="submit" class="btn btn-primary">Отправить</button>
</form>

<a asp-action="MedicalRecord" asp-route-appointmentId="@appointment?.Id" class="btn btn-secondary mt-3">Назад к карте</a>