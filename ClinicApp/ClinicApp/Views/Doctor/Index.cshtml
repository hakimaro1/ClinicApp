@model IEnumerable<ClinicApp.Models.TimeSlot>

<h2>Мое расписание</h2>

<p>
    <a asp-action="MyPatients" class="btn btn-info text-white">Мои пациенты (Записи)</a>
</p>

<p>
    <a asp-action="CreateSchedule" class="btn btn-success">Сгенерировать новое расписание</a>
</p>

<p>
    <a asp-action="Medications" class="btn btn-info text-white">Справочник лекарств</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Дата</th>
            <th>Начало</th>
            <th>Конец</th>
            <th>Статус</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var slot in Model)
        {
            <tr>
                <td>@slot.Start.ToString("dd.MM.yyyy")</td>
                <td>@slot.Start.ToString("HH:mm")</td>
                <td>@slot.End.ToString("HH:mm")</td>
                <td>@(slot.Status == "Free" ? "Свободен" : "Занят")</td>
            </tr>
        }
    </tbody>
</table>
