@{
    ViewData["Title"] = "Вход для сотрудников";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-success text-white text-center">
                    <h3>Вход для сотрудников</h3>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    <form asp-action="StaffLogin" method="post">
                        <div class="form-group mb-3">
                            <label>Email</label>
                            <input type="email" name="email" class="form-control" required />
                        </div>
                        <div class="form-group mb-3">
                            <label>Пароль</label>
                            <input type="password" name="password" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-success w-100">Войти как сотрудник</button>
                    </form>
                </div>
                <div class="card-footer text-center">
                    <a asp-controller="Home" asp-action="Index">Вернуться на главную</a>
                </div>
            </div>
        </div>
    </div>
</div>