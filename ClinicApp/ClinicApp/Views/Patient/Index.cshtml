@model ClinicApp.Models.PatientProfile

<h2>Мой профиль</h2>



<p>
    <a asp-action="MedicalHistory" class="btn btn-info text-white">Моя медицинская карта (История болезни)</a>
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-action="Index" method="post">
    <div class="form-group mb-3">
        <label asp-for="LastName">Фамилия</label>
        <input asp-for="LastName" class="form-control" />
    </div>
    <div class="form-group mb-3">
        <label asp-for="FirstName">Имя</label>
        <input asp-for="FirstName" class="form-control" />
    </div>
    <div class="form-group mb-3">
        <label asp-for="Patronymic">Отчество</label>
        <input asp-for="Patronymic" class="form-control" />
    </div>
    <!-- НОВОЕ ПОЛЕ -->
    <div class="form-group mb-3">
        <label asp-for="PhoneNumber">Телефон</label>
        <input asp-for="PhoneNumber" class="form-control" placeholder="+7 (999) 123-45-67" />
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
</form>

<p class="mt-3">
    <a asp-controller="Booking" asp-action="Index" class="btn btn-secondary">Вернуться к записи на прием</a>
</p>