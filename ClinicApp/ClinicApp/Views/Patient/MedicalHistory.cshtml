@model IEnumerable<ClinicApp.Models.MedicalRecord>

<h2>История болезни (Медицинская карта)</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.Any())
{
    <p>У вас пока нет записей о посещении врачей.</p>
}
else
{
    @foreach (var record in Model)
    {
        var appointment = record.Appointment;
        var doctor = appointment?.Doctor;
        var doctorName = $"{doctor?.LastName} {doctor?.FirstName}".Trim();
        if (string.IsNullOrWhiteSpace(doctorName)) doctorName = "Врач не указан";
        var specialization = doctor?.Specialization ?? "";

        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Дата визита: @appointment?.TimeSlot?.Start.ToString("dd.MM.yyyy HH:mm")</h5>
            </div>
            <div class="card-body">
                <p><strong>Врач:</strong> @doctorName (@specialization)</p>
                <hr />
                <p><strong>Диагноз:</strong> @record.Diagnosis</p>
                <p><strong>Назначенное лечение:</strong> @record.Treatment</p>
                <p><strong>История болезни (жалобы):</strong> @record.History</p>

                <h5 class="mt-4">Назначенные лекарства:</h5>
                @if (record.Medications != null && record.Medications.Any())
                {
                    <ul class="list-group">
                        @foreach (var med in record.Medications)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@med.Name</strong> (@med.Dosage, @med.Form)
                                </div>
                                <div>
                                    @if (med.IsTaken)
                                    {
                                        <span class="badge bg-success me-2">Принято</span>
                                    }
                                    else
                                    {
                                        <!-- Кнопка "Я принял" -->
                                        <form asp-action="MarkAsTaken" method="post" class="d-inline">
                                            <input type="hidden" name="medicationId" value="@med.Id" />
                                            <button type="submit" class="btn btn-sm btn-primary">Я принял</button>
                                        </form>

                                        <!-- Кнопка "Отменить" -->
                                        <form asp-action="CancelMedication" method="post" class="d-inline ms-2">
                                            <input type="hidden" name="medicationId" value="@med.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Отменить</button>
                                        </form>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">Лекарства не назначены.</p>
                }

                <!-- НОВАЯ КНОПКА: Чат с врачом -->
                <div class="mt-3">
                    <a asp-action="Chat" asp-route-appointmentId="@record.AppointmentId" class="btn btn-sm btn-outline-primary">Написать врачу (Чат)</a>
                </div>
            </div>
        </div>
    }
}

<a asp-action="Index" class="btn btn-secondary mt-3">Назад в профиль</a>