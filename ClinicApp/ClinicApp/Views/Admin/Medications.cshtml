@model IEnumerable<ClinicApp.Models.Medication>

<h2>Справочник лекарств</h2>
<p>
    <a asp-action="CreateMedication" class="btn btn-success">Добавить лекарство</a>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Название</th>
            <th>Дозировка</th>
            <th>Форма выпуска</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Dosage</td>
                <td>@item.Form</td>
            </tr>
        }
    </tbody>
</table>
